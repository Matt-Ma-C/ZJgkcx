# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Local launcher diagnostics
/*.log

# Prepared local desktop release
/.local-runtime/

# Personal research notes stay local
/docs/个人报考指南_计算机硕士_杭州六区.md
/docs/考情数据分析_2024-2026.md
*.tsbuildinfo
/*.lnk

# Private source datasets and secret key containers must stay local.
**/data-private/
*.key
*.pfx
*.p12
